{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-studio.local/schemas/build-manifest.schema.json",
  "title": "Agent Studio immutable build identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "application", "tag", "version", "commit", "dirty", "builtAt", "integrity", "codingAgentRunner", "codingAgentChat"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "application": { "const": "Agent Studio" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "commit": { "type": "string", "minLength": 7 },
    "dirty": { "type": "boolean" },
    "builtAt": { "type": "string", "format": "date-time" },
    "integrity": { "type": "string", "pattern": "^sha(256|512)-" },
    "codingAgentRunner": { "$ref": "#/$defs/artifact" },
    "codingAgentChat": { "$ref": "#/$defs/artifact" },
    "legacy": { "type": "boolean" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tag", "commit", "integrity"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 7 },
        "integrity": { "type": "string", "pattern": "^sha(256|512)-" }
      }
    }
  }
}
