{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-taskboard/agent-taskboard/docs/schemas/update-run-snapshot.schema.json",
  "title": "Update run pre/post snapshot",
  "description": "Captured by UpdateService at the start (kind=pre) and end (kind=post) of every run; written to <RunsDirectory>/<runId>/{pre,post}-snapshot.json. ADR-0031.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "runId", "capturedAt", "head", "projectModes", "healthzOk", "cliQuotaReachable"],
  "properties": {
    "kind": { "enum": ["pre", "post"] },
    "runId": { "type": "string", "minLength": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "head": { "type": "string", "description": "Short SHA at the time of the snapshot." },
    "projectModes": {
      "type": "object",
      "description": "Project name -> runner mode (auto-continuous | auto-pause-on-empty | manual | unknown).",
      "additionalProperties": { "type": "string" }
    },
    "healthzOk": { "type": "boolean" },
    "healthzBody": { "type": ["string", "null"] },
    "runnerStatusHttp": { "type": ["integer", "null"] },
    "jobsRecentCount": { "type": ["integer", "null"] },
    "clientsCount": { "type": ["integer", "null"] },
    "cliQuotaReachable": { "type": "boolean" }
  }
}
