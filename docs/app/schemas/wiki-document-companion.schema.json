{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-taskboard.local/schemas/wiki-document-companion.schema.json",
  "title": "Wiki Document Companion",
  "description": "Adjacent sidecar metadata for one Wiki document. The file lives next to the source document as <source-file>.meta.json and drives the document row metadata plus the generated companion HTML report. Several producers write into the same sidecar (companion generator, grading run, task cross-referencing, consolidation classification), so only the identity fields are required; every block is merged, never overwritten.",
  "type": "object",
  "required": ["$schema", "schemaVersion", "source"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://agent-taskboard.local/schemas/wiki-document-companion.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "wiki-document-companion/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human label for the source document."
    },
    "source": {
      "type": "object",
      "required": ["path", "type", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/.+",
          "description": "Repository-relative path of the document this companion describes."
        },
        "type": {
          "type": "string",
          "enum": ["markdown", "html", "json", "document"]
        },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "report": {
      "type": "object",
      "required": ["path", "generatedAt", "generator", "template"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/.+\\.report\\.html$",
          "description": "Repository-relative generated HTML report path. It should be adjacent to the source document."
        },
        "generatedAt": { "type": "string", "format": "date-time" },
        "generator": {
          "type": "string",
          "description": "Repository-relative generator script."
        },
        "template": { "type": "string" }
      }
    },
    "classification": {
      "type": "object",
      "required": ["owner", "documentMode", "temporalState", "implementationState"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "documentMode": {
          "type": "string",
          "description": "Documentation, concept, vision, operational, or mixed document mode."
        },
        "temporalState": {
          "type": "string",
          "enum": ["present", "current", "future", "past", "mixed", "unknown"],
          "description": "Direction signal shown in the Wiki tree."
        },
        "implementationState": {
          "type": "string",
          "description": "Implemented, partial, planned, aspirational, or unknown implementation state."
        },
        "status": {
          "type": "string",
          "enum": ["aktuell", "veraltet", "ueberholt", "archived"],
          "description": "Curated lifecycle status: aktuell = current, veraltet = dated with no direct successor, ueberholt = superseded by a newer page, archived = retained as quiet history."
        },
        "supersededBy": {
          "type": ["string", "null"],
          "description": "Docs-relative path of the successor page when status is 'ueberholt' (e.g. 'operations/haertung-verteilte-ausfuehrung/historie.html'); null otherwise."
        },
        "type": {
          "type": "string",
          "enum": ["konzept", "adr", "contract", "domain-map", "analyse", "runbook", "workbench", "mockup", "proposal", "generiert", "index"],
          "description": "Curated document kind shown as a compact code in the Wiki tree. Pages without a sidecar fall back to a per-folder default in the backend."
        },
        "analyzedAt": {
          "type": "string",
          "format": "date",
          "description": "Date of the consolidation analysis that produced the curated classification fields."
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["date", "method", "model", "sourceFingerprint", "sourceChangedSinceReview"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "method": { "type": "string" },
        "model": { "type": "string" },
        "sourceFingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceChangedSinceReview": {
          "type": "boolean",
          "description": "Stored generator verdict. The backend also recomputes the current source hash and can mark stale companions live."
        }
      }
    },
    "drift": {
      "type": "object",
      "required": ["grade", "hasDrift", "score", "summary", "rationale"],
      "additionalProperties": true,
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "unknown"] },
        "hasDrift": { "type": ["boolean", "null"] },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "summary": { "type": "string" },
        "rationale": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "grading": {
      "type": "object",
      "description": "Optional LLM assessment written by a wiki-grading maintenance run (AGT-2051). Separate from the deterministic 'drift' block: this is a strong-model verdict on whether the page is outdated, contradictory, or has gaps. Absent until a grading pass has run over the page.",
      "required": ["grade", "assessment", "model", "gradedAt", "sourceFingerprint"],
      "additionalProperties": true,
      "properties": {
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "unknown"] },
        "assessment": { "type": "string" },
        "outdated": { "type": ["boolean", "null"] },
        "contradictory": { "type": ["boolean", "null"] },
        "gaps": { "type": ["boolean", "null"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "cli": { "type": "string" },
        "model": { "type": "string" },
        "thinkingLevel": { "type": ["string", "null"] },
        "method": { "type": "string" },
        "runId": { "type": "string" },
        "gradedAt": { "type": "string", "format": "date-time" },
        "ok": { "type": "boolean" },
        "sourceFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "agentReads": {
      "type": "object",
      "description": "Observed agent tool-use reads of this wiki page. This is durable usage evidence only; it never drives drift, gates, or workflow state.",
      "required": ["total", "lastReadAt", "recent"],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Lifetime number of attributed agent read tool-uses reconstructed from task logs plus continuously observed runs."
        },
        "lastReadAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "recent": {
          "type": "array",
          "maxItems": 20,
          "description": "Newest attributed reads first, capped at 20 entries.",
          "items": {
            "type": "object",
            "required": ["at", "taskKey"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "taskKey": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "axes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "duplicates": {
      "type": "object",
      "required": ["suspected", "groupSize", "similarTo"],
      "additionalProperties": false,
      "properties": {
        "suspected": { "type": "boolean" },
        "groupSize": { "type": "integer", "minimum": 1 },
        "similarTo": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Structured explanation facts consumed by the generated HTML report.",
      "items": {
        "type": "object",
        "required": ["id", "severity", "axis", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warn", "error"] },
          "axis": { "type": "string" },
          "summary": { "type": "string" },
          "rationale": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "nextAction": { "type": "string" },
    "relatedTasks": {
      "type": "array",
      "description": "Task cross-references written by the wiki task cross-referencing service. Historically some sidecars carry only this block.",
      "items": {
        "type": "object",
        "required": ["key", "title", "linkedAt", "source"],
        "additionalProperties": true,
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "linkedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "enum": ["auto", "manual"] }
        }
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "required": ["algorithm", "hash", "sizeBytes", "lineCount", "capturedAt"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "lineCount": { "type": "integer", "minimum": 0 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
