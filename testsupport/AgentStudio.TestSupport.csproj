<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Shared helpers, not a suite. Without this the xunit reference makes
         `dotnet test agent-taskboard.sln` try to run this assembly as a test
         project, which aborts the whole run. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <!-- The deployment scenario is its own executable project below this
         shared-helper directory. Keep its sources and build output out of the
         parent SDK project's recursive default glob. -->
    <Compile Remove="scenario/**/*.cs" />
    <EmbeddedResource Remove="scenario/**" />
    <None Remove="scenario/**" />
  </ItemGroup>

</Project>
