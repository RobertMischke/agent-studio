<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrchestratorApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentTaskboard.Shared\AgentTaskboard.Shared.csproj" />
    <ProjectReference Include="..\AgentTaskboard.OutputParser\AgentTaskboard.OutputParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The executor (CLI) services moved here from the monolith carry internal
         test seams (BuildStartInfoForTest, TryExtractSessionId, ...). The unit
         tests live in OrchestratorApi.Tests; grant it access as the monolith does. -->
    <InternalsVisibleTo Include="OrchestratorApi.Tests" />
  </ItemGroup>

</Project>
