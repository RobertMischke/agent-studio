<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roslyn analyzer that fails the build (per .editorconfig severity) when a
       catch block is empty / comment-only. Keeps the "no silent catch" rule
       from regressing. Analyzers must target netstandard2.0 and are loaded by
       the compiler, never shipped as a runtime dependency. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Advisory analyzer-authoring rules that do not apply to a single-rule
         internal analyzer: release tracking + extended-rules opt-in. -->
    <NoWarn>$(NoWarn);RS2008;RS1036</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
