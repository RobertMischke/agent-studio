{
  "name": "agent-studio-remote-test-suite",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "compose:inspect": "node compose-harness.mjs inspect",
    "compose:run": "node compose-harness.mjs run",
    "test:compose": "REMOTE_TEST_COMPOSE_INTEGRATION=1 node --test test/compose-harness.integration.test.mjs",
    "test:machine-bound:autonomy": "REMOTE_TEST_COMPOSE_MACHINE_BOUND=1 node --test test/compose-harness.integration.test.mjs"
  }
}
