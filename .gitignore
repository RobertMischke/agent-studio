frontend/screenshots/
test-results/

# Local mockup screenshot evidence is useful during review, but it is generated
# output. Keep it on disk for inspection, not in the source repository.
docs/mockups/**/evidence/*.png
docs/mockups/**/evidence/**/*.png

# Per-checkout local config overrides (e.g. Environment:IsDev for the dev banner)
backend/appsettings.Local.json
.frontend.pid
.frontend.log

# Rolling backend logs (logs/backend/<date>.log + last-crash.json) live at the
# repo root at runtime. Runtime artefacts never belong in source.
logs/

# ng serve runtime logs (frontend dev server). Per-port files like
# .ng-serve-4021.out.log / .err.log are runtime artefacts; never commit.
frontend/.ng-serve-*.log
frontend/.ng-serve-*.out.log
frontend/.ng-serve-*.err.log
frontend/.ng-serve-*.pid
