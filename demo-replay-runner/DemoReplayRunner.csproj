<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>demo-replay-runner</AssemblyName>
    <RootNamespace>AgentStudio.DemoReplayRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemoReplayRunner.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The replay service references the shared trace contract and nothing else.
      It deliberately does not reference the runner, the backend, or any CLI
      hosting package: there is no code path in this image that could claim,
      lease, or execute work.
    -->
    <ProjectReference Include="..\contracts\TaskServer.Contracts\TaskServer.Contracts.csproj" />
  </ItemGroup>

</Project>
