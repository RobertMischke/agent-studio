{
  "extends": ["stylelint-config-standard-scss"],
  "plugins": ["stylelint-declaration-strict-value"],
  "rules": {
    "selector-class-pattern": null,
    "selector-id-pattern": null,
    "scss/dollar-variable-pattern": null,
    "scss/at-mixin-pattern": null,
    "scss/percent-placeholder-pattern": null,
    "scss/at-function-pattern": null,
    "scss/no-global-function-names": null,
    "scss/load-no-partial-leading-underscore": null,
    "scss/at-rule-no-unknown": [true, { "ignoreAtRules": ["use", "forward", "include", "mixin", "function", "if", "else", "for", "each", "while", "return", "extend", "tailwind", "apply", "screen", "responsive", "variants"] }],
    "scss/operator-no-newline-after": null,
    "scss/operator-no-unspaced": null,
    "scss/comment-no-empty": null,
    "color-function-notation": null,
    "color-function-alias-notation": null,
    "alpha-value-notation": null,
    "hue-degree-notation": null,
    "shorthand-property-no-redundant-values": null,
    "no-descending-specificity": null,
    "no-duplicate-selectors": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "declaration-block-no-shorthand-property-overrides": null,
    "declaration-block-single-line-max-declarations": null,
    "declaration-empty-line-before": null,
    "rule-empty-line-before": null,
    "comment-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "at-rule-no-deprecated": null,
    "no-empty-source": null,
    "no-invalid-position-at-import-rule": null,
    "media-feature-range-notation": null,
    "value-keyword-case": null,
    "function-no-unknown": null,
    "function-url-quotes": null,
    "length-zero-no-unit": null,
    "comment-whitespace-inside": null,
    "selector-pseudo-element-no-unknown": [true, { "ignorePseudoElements": ["ng-deep"] }],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["host", "host-context", "deep", "global"] }],
    "property-no-vendor-prefix": null,
    "value-no-vendor-prefix": null,
    "selector-no-vendor-prefix": null,
    "import-notation": null,
    "number-max-precision": null,
    "keyframes-name-pattern": null,
    "scss/double-slash-comment-empty-line-before": null,
    "scss/double-slash-comment-whitespace-inside": null,
    "color-hex-length": null,
    "selector-not-notation": null,
    "property-no-deprecated": null,
    "declaration-property-value-keyword-no-deprecated": null,
    "media-feature-name-value-no-unknown": null,
    "declaration-property-value-no-unknown": null,
    "declaration-block-no-duplicate-properties": null,
    "custom-property-empty-line-before": null,
    "scss/dollar-variable-colon-space-after": null,
    "scss/dollar-variable-colon-space-before": null,
    "scss/dollar-variable-empty-line-before": null,
    "scss/dollar-variable-default": null,
    "font-family-name-quotes": null,
    "font-family-no-missing-generic-family-keyword": null,

    "color-no-hex": true,
    "color-named": ["never", { "ignore": ["inside-function"] }],
    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "background", "background-color", "border-color", "fill", "stroke"],
      {
        "ignoreValues": [
          "transparent", "currentColor", "inherit", "initial", "unset", "none", "revert", "revert-layer", "0",
          "/^color-mix\\(/",
          "/^linear-gradient\\(/",
          "/^radial-gradient\\(/",
          "/^conic-gradient\\(/",
          "/^url\\(/"
        ],
        "ignoreFunctions": false,
        "disableFix": true,
        "severity": "error"
      }
    ]
  },

  "overrides": [
    {
      "files": [
        "src/styles/_tokens-primitives.scss",
        "src/styles/_tokens-semantic.scss",
        "src/styles/_markdown-body.scss"
      ],
      "rules": {
        "color-no-hex": null,
        "scale-unlimited/declaration-strict-value": null
      }
    },
    {
      "comment": "Mockup tree (next-gen-chat). Not shipped to production; keeps designer-friendly raw hex. Exempt entirely.",
      "files": [
        "src/mockups/**/*.scss"
      ],
      "rules": {
        "color-no-hex": null,
        "scale-unlimited/declaration-strict-value": null
      }
    },
    {
      "comment": "Legacy SCSS files pending Tier-1/Tier-2 migration. Each removed entry below is a migration win. New SCSS files are NOT added here; they conform from day one. Track progress under `docs/frontend-scss-quality.md` Wave A.",
      "files": [
        "src/styles.scss",
        "src/app/app.scss",
        "src/app/components/chat-row/chat-row.component.scss",
        "src/app/components/chat/chat/chat.component.scss",
        "src/app/components/chat/conversation-view/conversation-view.component.scss",
        "src/app/components/chat/tool-burst-chip/tool-burst-chip.component.scss",
        "src/app/components/concept-help/concept-help.component.scss",
        "src/app/components/info-button/info-button.component.scss",
        "src/app/components/markdown-rich-editor/markdown-rich-editor.scss",
