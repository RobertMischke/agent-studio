# One file per Coding or Review service identity.
RUNNER_SERVER_URL=https://tasks.example.com
RUNNER_ID=replace-with-enrolled-runner-id
RUNNER_NAME=agent-runner-01
RUNNER_ROLE=coding
RUNNER_AUTH_TOKEN_FILE=/etc/agent-host/runner.token
RUNNER_GIT_REMOTE=https://github.com/example/project.git
RUNNER_GIT_PUSH_REMOTE=git@github.com:example/project.git
RUNNER_WORKDIR=/var/lib/agent-host/runner-work
RUNNER_STATE_DIR=/var/lib/agent-host/state
RUNNER_MAX_PARALLELISM=2
