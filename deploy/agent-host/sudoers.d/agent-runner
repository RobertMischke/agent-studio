# Least-privilege service-account policy for agent-runner-01.
# Install as /etc/sudoers.d/agent-runner with owner root:root and mode 0440.

Cmnd_Alias AGENT_RUNNER_SERVICE_CONTROL = \
    /usr/bin/systemctl restart agent-runner.service, \
    /usr/bin/systemctl restart agent-runner-review.service, \
    /usr/bin/systemctl status agent-runner.service --no-pager, \
    /usr/bin/systemctl status agent-runner-review.service --no-pager

# The empty argument string is intentional. sudoers(5) then permits the helper
# only without arguments. The root-owned helper validates fixed ingress and
# release paths before changing the atomic current link.
Cmnd_Alias AGENT_RUNNER_DEPLOY = /usr/local/sbin/agent-runner-deploy ""

agent ALL=(root) NOPASSWD: AGENT_RUNNER_SERVICE_CONTROL, AGENT_RUNNER_DEPLOY
