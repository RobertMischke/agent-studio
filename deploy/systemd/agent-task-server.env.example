ASPNETCORE_URLS=http://127.0.0.1:5071
TaskServer__DataDirectory=/var/lib/agent-task-server
TaskServer__MinimumLeaseSeconds=30
TaskServer__MaximumLeaseSeconds=600
TaskServer__MaximumEventPayloadBytes=262144
TaskServer__RequireAuthentication=false
# When authentication is enabled, inject distinct values from the host secret
# store. Do not commit either credential to this file.
# TaskServer__StudioBearerToken=
# TaskServer__RunnerBearerToken=
