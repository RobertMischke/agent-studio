[Unit]
Description=Agent Studio Task Server control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-task-server
Group=agent-task-server
WorkingDirectory=/var/lib/agent-task-server
EnvironmentFile=/etc/agent-task-server/server.env
ExecStart=/opt/agent-task-server/agent-task-server
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillSignal=SIGTERM
SyslogIdentifier=agent-task-server
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-task-server

[Install]
WantedBy=multi-user.target
