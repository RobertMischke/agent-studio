[Unit]
Description=Agent Orchestrator Task Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-orchestrator
Group=agent-orchestrator
WorkingDirectory=/var/lib/agent-orchestrator
EnvironmentFile=/etc/agent-orchestrator/server.env
ExecStart=/opt/agent-orchestrator/current/task-server
Restart=always
RestartSec=5s
TimeoutStopSec=90s
KillSignal=SIGTERM
SyslogIdentifier=task-server
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-orchestrator

[Install]
WantedBy=multi-user.target
