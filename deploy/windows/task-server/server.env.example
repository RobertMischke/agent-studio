# Bootstrap contract consumed by task-server.exe on Windows.
# start-task-server.ps1 imports these values into the service process only.
LISTEN_URL=http://127.0.0.1:5071
STORE_PATH=C:\ProgramData\AgentOrchestrator\data
BACKUP_PATH=C:\ProgramData\AgentOrchestrator\data\backups
AUTH=bearer
AUTH_TOKEN_FILE=C:\ProgramData\AgentOrchestrator\task-server.token

# Operational defaults retained until lease policy moves into the store.
TaskServer__MinimumLeaseSeconds=30
TaskServer__MaximumLeaseSeconds=600
TaskServer__MaximumEventPayloadBytes=262144
TaskServer__RequireAuthentication=false
# When authentication is enabled, inject distinct values from the host secret
# store. Do not commit either credential to this file.
# TaskServer__StudioBearerToken=
# TaskServer__RunnerBearerToken=
